# Copy to .env. Demo mode needs no external services.
DEMO_MODE=true
PORT=4000
APP_URL=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://classorbit:classorbit@localhost:5432/classorbit?connect_timeout=15
# Use a direct/unpooled URL for migrations. For local Postgres, use the same URL.
DIRECT_URL=postgresql://classorbit:classorbit@localhost:5432/classorbit?connect_timeout=15
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=./uploads
# FFmpeg is included in the Docker worker; set this only for a native worker.
FFMPEG_PATH=ffmpeg
VIDEO_QUEUE_PREFIX=bull
# Razorpay TEST keys only; live keys are rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional private S3 / CloudFront delivery; see README.md
AWS_REGION=us-east-1
S3_BUCKET=
CLOUDFRONT_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
# Prefer a private-key file (API only), or set the escaped PEM above.
CLOUDFRONT_PRIVATE_KEY_FILE=
# urls works with localhost and the default CloudFront HTTPS address; no domain needed.
CLOUDFRONT_AUTH_MODE=urls
CLOUDFRONT_URL_TTL=900
# Only cookies mode needs app/CDN hosts under a shared domain.
CDN_COOKIE_DOMAIN=
# JSON array of RTCIceServer entries. Add TURN for real networks.
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# Optional local AWS test credentials; prefer an IAM role on the host.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
